if ! git diff --cached --quiet -- src-tauri/icons/icon.icon; then
  echo "Regenerating Assets.car from staged icon.icon..."
  assets_rel=src-tauri/icons/Assets.car
  preserve_worktree_assets=false
  if git ls-files --error-unmatch "$assets_rel" >/dev/null 2>&1 &&
    ! git diff --quiet -- "$assets_rel"
  then
    preserve_worktree_assets=true
  fi

  generated_assets=$(mktemp)
  trap 'rm -f "$generated_assets"' 0 HUP INT TERM
  npm run icon:macos -- --staged --output "$generated_assets"
  assets_blob=$(git hash-object -w "$generated_assets")
  git update-index --add --cacheinfo "100644,$assets_blob,$assets_rel"

  if [ "$preserve_worktree_assets" = false ]; then
    cp "$generated_assets" "$assets_rel"
  fi
fi

npx lint-staged
npm run typecheck
npm run test

if git diff --cached --name-only | grep -q '^src-tauri/'; then
  (cd src-tauri && cargo test --lib)
fi
